        <?
          $ares=$aAllResult;
          if(isset($ares[$aProgramma['ID']][$is])>0){
            $txtres='<div class="prot_result">'.
            '<div class="gray">'.array_sum($ares[$aProgramma['ID']][$is]).'</div>'.
            implode('<br>',$ares[$aProgramma['ID']][$is]).
            '</div>';
          }elseif($ed){
            $txtres='<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus" viewBox="0 0 16 16">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg>';
          }else{
            $txtres=' - ';
