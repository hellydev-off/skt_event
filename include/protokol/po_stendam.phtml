          data-userid="<?=$aUserSportsmen['ID']?>"
          data-seriya="<?=$is?>"
          data-smena="<?=$smenaStend['smena']?>"
          data-stend="<?=$smenaStend['stend']?>"
          data-region="<?=Aiplk::getRegionTitle($aUserSportsmen)['txt']?>"
          data-results='<?=json_encode($ares[$aProgramma['ID']][$is], JSON_UNESCAPED_UNICODE)?>'
          href="#">
            <?=$txtres?>
        </a>
        <?}else{?>
          <span><?=$txtres?></span>
        <?}?>
