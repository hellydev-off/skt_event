    $aItems[$k]['stend']=$smenaStend['stend'];
    $aItems[$k]['mesto']=$aMestoFromPrg[$aUserSportsmen['ID']][0];
  }
  //v($aItems);
  if(isset($_REQUEST['sort_mesta']) and $_REQUEST['sort_mesta']=='Y'){
    //sort по местам
    usort($aItems, function($a, $b){
      if($a['mesto']==$b['mesto'])return 0;
      return $a['mesto']<$b['mesto']?-1:1;
    });
  }else{
    //sort по сменам, стендам
    usort($aItems, function($a, $b){
      if($a['stend']==$b['stend'])return 0;
      return $a['stend'] < $b['stend']?-1:1;
    });
    usort($aItems, function($a, $b){
      if($a['smena']==$b['smena'])return 0;
      return $a['smena'] < $b['smena']?-1:1;
    });  
    //
  }
  foreach($aItems as $aUserSportsmen){
