  Aiplk::sortSprts($aItems, $aProgramma['PROPERTIES']['DISCIPLINA']['VALUE']);
  //var_dump('<pre>',$aMestoFromPrg,'</pre>');
  foreach($aItems as $k=>$aUserSportsmen){
    if(!isset($aMestoFromPrg[$aUserSportsmen['ID']])){
      unset($aItems[$k]);
      continue;
    }
    $_aMesto=$aMestoFromPrg[$aUserSportsmen['ID']];
    $smenaStend=Aiplk::protokolGetStendSmena($kolvo_stendov, $_aMesto[2], $aProgramma['PROPERTIES']['KOLVO_STENDOV']['VALUE'], $aProgramma['PROPERTIES']['SO_STENDA']['VALUE'], $aProgramma['PROPERTIES']['S_SERII']['VALUE']);
