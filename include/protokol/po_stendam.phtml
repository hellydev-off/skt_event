  	$smenaStend=Aiplk::protokolGetStendSmena($kolvo_stendov, $_aMesto[2], $aProgramma['PROPERTIES']['KOLVO_STENDOV']['VALUE'], $aProgramma['PROPERTIES']['SO_STENDA']['VALUE'], $aProgramma['PROPERTIES']['S_SERII']['VALUE']);
  	?>
    
    <td>
      <div><?=$aUser['LAST_NAME']?> <?=$aUser['NAME']?> <?=$aUser['SECOND_NAME']?></div>
